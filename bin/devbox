#!/bin/sh
# devbox — the CLI.
#
#   devbox up     <profile> <path>   build and start the box for that worktree
#   devbox shell  <profile> <path>   shell into the running box
#   devbox down   <profile> <path>   stop and remove it; --purge also drops data
#         --rebuild                   force the image build (after editing this repo)
#   devbox doctor <profile> <path>   validate the effective config (I1–I4)
#   devbox policy <commits-allowed|review-only> <path>
#   devbox policy --list
#
# <path> is a repository root or a git worktree root. The box mounts that tree
# and its gitdir at their own host paths (0003 D1), so git metadata written by
# the host resolves unchanged inside the box; there is no /workspace.
#
# Canonical config resolves from this repo, never from the mounted project
# (D7, I6, criterion 9). The socket and the Docker CLI plugins are resolved here,
# never inherited from the ambient environment (AGENTS.md slice-1 finding).
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/.." && pwd)
profiles_dir=${DEVBOX_PROFILES_DIR:-$repo/profiles}
compose_file=${DEVBOX_COMPOSE_FILE:-$repo/compose/devbox.compose.yaml}
slr_src=${SLR_SRC:-$HOME/.cache/devbox/slr-src}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/devbox
# 0004 D2 — the agent's sources are these two checkouts, materialised per `up`.
pi_ext_repo=${PIEXT_REPO:-$HOME/source/priv/pi-extensions}
skillset_repo=${SKILLSET_REPO:-$HOME/source/priv/skillset}
contexts_dir=$state_dir/contexts

. "$repo/harnesses/lib/agent-payload.sh"

die() { echo "devbox: $*" >&2; exit 1; }

# Git under a cleared environment. An exported GIT_DIR, GIT_WORK_TREE or
# GIT_COMMON_DIR would divert the very paths this CLI mounts, and doctor resolves
# through the same call, so it could not notice (review Q1).
dgit() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR GIT_OPTIONAL_LOCKS=0 git "$@"; }

usage() {
  sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//'
  echo ""
  echo "profiles: $(cd "$profiles_dir" && ls ./*.yaml 2>/dev/null | sed 's|\./||;s|\.yaml||' | tr '\n' ' ')"
  exit "${1:-1}"
}

[ "$#" -ge 1 ] || usage 1
verb=$1
shift
case "$verb" in -h|--help|help) usage 0 ;; esac

# D3 — the commit policy is machine-local, keyed by the absolute worktree path,
# and never resolved from inside a mounted workspace (I6). Absent means commits
# allowed; a file that cannot be read is refused rather than ignored, because
# failing open here would silently un-restrict a review-only project.
policy_file() { printf '%s/policy/%s.policy' "$state_dir" "$(printf '%s' "$1" | shasum -a 256 | cut -c1-16)"; }

policy_read() {
  file=$(policy_file "$1")
  [ -f "$file" ] || { echo commits-allowed; return 0; }
  mode=$(sed -n 1p "$file")
  case "$mode" in
    commits-allowed|review-only) echo "$mode" ;;
    *) die "unreadable commit policy: $file — remove it or set it with: devbox policy <mode> <path>" ;;
  esac
}

case "$verb" in
  policy)
    case "${1:-}" in
      --list)
        shift
        [ "$#" -eq 0 ] || usage 1
        for file in "$state_dir"/policy/*.policy; do
          [ -f "$file" ] || continue
          printf '%-15s %s\n' "$(sed -n 1p "$file")" "$(sed -n 2p "$file")"
        done
        exit 0
        ;;
      commits-allowed|review-only) mode=$1; shift ;;
      *) usage 1 ;;
    esac
    [ "$#" -eq 1 ] || usage 1
    [ -d "$1" ] || die "no such directory: $1"
    path=$(cd "$1" && pwd -P)
    top=$(dgit -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$top" ] && [ "$top" != "$path" ]; then
      die "$path is inside the worktree at $top — point devbox at the worktree root"
    fi
    mkdir -p "$state_dir/policy"
    file=$(policy_file "$path")
    printf '%s\n%s\n' "$mode" "$path" > "$file.tmp"
    mv "$file.tmp" "$file"
    echo "devbox: $path is $mode"
    exit 0
    ;;
esac

# The host's $DOCKER_HOST points at the legacy colima path, so resolve it here.
docker_host=${DEVBOX_DOCKER_HOST:-}
if [ -z "$docker_host" ]; then
  for sock in "$HOME/.colima/default/docker.sock" "$HOME/.colima/docker.sock"; do
    [ -S "$sock" ] && { docker_host="unix://$sock"; break; }
  done
  [ -n "$docker_host" ] || die "no colima socket found — start it with: colima start"
fi

# The Homebrew plugins are not on the CLI's search path on Apple Silicon, and
# without buildx `docker build` silently falls back to the legacy builder (A3).
docker_config=${DEVBOX_DOCKER_CONFIG:-}
if [ -z "$docker_config" ]; then
  docker_config="$state_dir/docker"
  mkdir -p "$docker_config/cli-plugins"
  for dir in /opt/homebrew/lib/docker/cli-plugins /usr/local/lib/docker/cli-plugins; do
    [ -d "$dir" ] || continue
    for plugin in "$dir"/docker-compose "$dir"/docker-buildx; do
      [ -x "$plugin" ] && ln -sf "$plugin" "$docker_config/cli-plugins/"
    done
  done
  if [ -f "$HOME/.docker/config.json" ] && [ ! -e "$docker_config/config.json" ]; then
    ln -sf "$HOME/.docker/config.json" "$docker_config/config.json"
  fi
fi
export DOCKER_HOST="$docker_host" DOCKER_CONFIG="$docker_config"

purge=0
rebuild=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --purge) purge=1; shift ;;
    --rebuild) rebuild=1; shift ;;
    --*) die "unknown option: $1" ;;
    *) break ;;
  esac
done

profile=${1:-}
project=${2:-}
[ -n "$profile" ] && [ -n "$project" ] || usage 1
case "$profile" in */*|*..*) die "profile must be a name, not a path: $profile" ;; esac

profile_file="$profiles_dir/$profile.yaml"
[ -f "$profile_file" ] || die "no such profile: $profile"
[ -f "$compose_file" ] || die "no such compose file: $compose_file"

[ -d "$project" ] || die "no such project directory: $project"
project=$(cd "$project" && pwd -P)

# The box's host boundary is the worktree and its gitdir (0003, ADR 0001 amendment). A
# subdirectory of a worktree is refused rather than silently boxed; a linked
# worktree resolves its common gitdir, which is what git needs to find objects,
# refs and per-worktree state.
worktree=$project
top=$(dgit -C "$project" rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$top" ] && [ "$top" != "$project" ]; then
  die "$project is inside the worktree at $top — point devbox at the worktree root"
fi
if [ -n "$top" ]; then
  gitdir=$(cd "$project" && cd "$(dgit rev-parse --git-common-dir)" && pwd -P)
else
  # A project with a .git file and no resolvable repository is a broken worktree
  # pointer, not a new project: initialising here would silently detach it
  # (review Q4).
  [ ! -f "$project/.git" ] ||
    die "$project/.git is a worktree pointer that does not resolve — run: git worktree repair"
  gitdir=$project/.git
fi

# D5 — a repo carrying a git extension the image's git cannot read is refused
# before anything starts, instead of being discovered by the agent mid-run.
refuse_unknown_extensions() {
  [ -n "$top" ] || return 0
  extensions=$(dgit -C "$worktree" config --local --get-regexp '^extensions\.' 2>/dev/null | awk '{print $1}' || true)
  for ext in $extensions; do
    case "$ext" in
      extensions.relativeworktrees|extensions.refstorage|extensions.compatobjectformat)
        die "repository uses $ext, which the image's git (2.43) cannot read — recreate the worktree without relative paths and retry" ;;
    esac
  done
}

# D4 — `up` mounts the hooks directory read-only, so it has to exist; and the
# worktree home is kept out of git's status through the shared exclude file,
# never by editing a tracked .gitignore.
prepare_gitdir() {
  if [ ! -d "$gitdir" ]; then
    echo "devbox: no repository at $worktree — initialising one" >&2
    dgit -C "$worktree" init -q
    gitdir=$worktree/.git
  fi
  mkdir -p "$gitdir/hooks"
  # Only a tree that can actually host the worktree home needs the exclusion;
  # every other repository is left untouched (review Q6).
  excluded=0
  case "$worktree" in */.devbox/*) excluded=1 ;; esac
  if [ -d "$worktree/.devbox" ]; then excluded=1; fi
  if [ "$excluded" = 1 ]; then
    mkdir -p "$gitdir/info"
    if ! grep -qxF '.devbox/' "$gitdir/info/exclude" 2>/dev/null; then
      printf '.devbox/\n' >> "$gitdir/info/exclude" ||
        echo "devbox: warning — could not add .devbox/ to $gitdir/info/exclude" >&2
    fi
  fi
  return 0
}

# Compose project name: readable, and unique per absolute path so two projects
# — or two worktrees of one project — cannot collide.
slug=$(basename "$worktree" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{1,\}$//')
uniq=$(printf '%s' "$worktree" | shasum -a 256 | cut -c1-8)
project_name="devbox-$slug-$uniq"

# 0004 D1 — the harness decides whether the box carries an agent at all: only an
# agent harness has sources to materialise and a stamp to compare.
profile_harness() {
  harness=$(sed -n 's/^[[:space:]]*HARNESS:[[:space:]]*[\"'\'']\{0,1\}\([a-z][a-z0-9-]*\).*/\1/p' "$profile_file" | tail -1)
  # A profile may also write it as a flow map, the shape every profile already
  # uses for additional_contexts; the `[{,]` anchor keeps comments out of it.
  [ -n "$harness" ] || harness=$(sed -n 's/.*[{,][[:space:]]*HARNESS:[[:space:]]*[\"'\'']\{0,1\}\([a-z][a-z0-9-]*\).*/\1/p' "$profile_file" | tail -1)
  echo "${harness:-none}"
}

# The harness name selects a script; without that check a typo is accepted here,
# materialises 15 MB, stamps an image and only then fails at the Dockerfile COPY.
require_harness_script() {
  [ "$1" = none ] && return 0
  [ -f "$repo/harnesses/$1.sh" ] ||
    die "no harness script for '$1' — expected $repo/harnesses/$1.sh"
}

# 0004 D2/D3 — materialise both sources into build contexts and stamp the result.
# The stamp is the commit plus a digest of the materialised set per source, plus
# the build inputs the sources do not describe — the harness and the browser mode
# — so a changed build input is never silently reused. A dirty, added or deleted
# file moves the stamp; an ignored file never does; the same content twice yields
# the same stamp.
#
# Each context is named by its own digest: nothing is overwritten in place, so a
# concurrent `up` on another worktree can never rewrite the directory a running
# build is reading, and no lock is needed. `prepare_agent_payload <root>` takes a
# payload_scratch root — doctor uses one, because validating a config must not write the
# machine's real store.
prepare_agent_payload() {
  payload_root=${1:-$contexts_dir}
  mkdir -p "$payload_root"
  sources=$payload_root/SOURCES
  : > "$sources.tmp.$$"
  for spec in "pi-extensions PIEXT_REPO $pi_ext_repo" "skillset SKILLSET_REPO $skillset_repo"; do
    name=${spec%% *}
    env_var=$(printf '%s' "${spec#* }" | cut -d' ' -f1)
    src=${spec##* }
    if [ ! -d "$src" ]; then
      echo "devbox: agent source $name not found at $src — clone it, or point $env_var at it" >&2
      return 1
    fi
    payload_scratch=$payload_root/.tmp.$name.$$
    payload_materialize "$src" "$payload_scratch" || {
      echo "devbox: could not materialise $name from $src" >&2
      return 1
    }
    payload_guard "$payload_scratch" || {
      find "$payload_scratch" -depth -delete
      echo "devbox: refusing the agent payload from $src — see above" >&2
      return 1
    }
    digest=$(payload_digest "$payload_scratch")
    context=$payload_root/$name.$(printf '%s' "$digest" | cut -c1-12)
    if [ -d "$context" ]; then find "$payload_scratch" -depth -delete; else mv "$payload_scratch" "$context"; fi
    case "$name" in
      pi-extensions) pi_ext_context=$context ;;
      skillset) skillset_context=$context ;;
    esac
    printf '%s %s %s\n' "$name" \
      "$(dgit -C "$src" rev-parse HEAD)" "$digest" >> "$sources.tmp.$$"
  done
  # A context is reached only through the digest-named path this run resolved, so
  # the pre-digest layout's fixed names are dead weight left on the machine.
  for legacy in "$payload_root/pi-extensions" "$payload_root/skillset"; do
    [ -d "$legacy" ] && find "$legacy" -depth -delete
  done
  mv "$sources.tmp.$$" "$sources"
  agent_sources=$(cat "$sources")
  agent_stamp=$(printf '%s\nharness=%s\nbrowser=%s\n' \
    "$agent_sources" "$(profile_harness)" "$browser_mode" | shasum -a 256 | cut -c1-16)
  pi_ext_source=$(sed -n 's/^pi-extensions //p' "$sources")
  skillset_source=$(sed -n 's/^skillset //p' "$sources")
  # Where the contexts are, as this script alone resolved them: an ambient
  # DEVBOX_PIEXT_SRC in the operator's environment must not reach a build (D2).
  piext_src=$pi_ext_context
  skillset_src=$skillset_context
}

compose() {
  DEVBOX_REPO="$repo" DEVBOX_PROFILE="$profile" DEVBOX_WORKTREE="$worktree" \
  DEVBOX_GITDIR="$gitdir" DEVBOX_GITDIR_RO="$gitdir_ro" \
  DEVBOX_PROJECT_NAME="$project_name" SLR_SRC="$slr_src" \
  DEVBOX_AGENT_STAMP="$agent_stamp" DEVBOX_PIEXT_SOURCE="$pi_ext_source" \
  DEVBOX_SKILLSET_SOURCE="$skillset_source" DEVBOX_BROWSER_MODE="$browser_mode" \
  DEVBOX_PIEXT_SRC="$piext_src" DEVBOX_SKILLSET_SRC="$skillset_src" \
  docker compose --profile build -f "$compose_file" -f "$profile_file" "$@"
}

# doctor reads the *effective* config, so interpolation and profile merges are
# already resolved before anything is checked (criterion 2).
doctor() {
  command -v jq >/dev/null 2>&1 || die "doctor needs jq (brew install jq)"
  refuse_unknown_extensions
  [ -d "$gitdir/hooks" ] ||
    die "D4: $gitdir/hooks does not exist — its read-only mount would create a host directory; run: devbox up $profile $worktree"
  # 0004 D3 — the stamp `up` would build is computed before the config is read and
  # into a throwaway root, so the checked config carries the contexts a build
  # would carry, and validation writes nothing to the machine's store. A missing
  # source is not an I1–I4 violation — it breaks the build (D2) — so it is
  # reported below and does not decide this check.
  harness=$(profile_harness)
  doctor_root=""
  payload_ready=1
  if [ "$harness" != none ]; then
    require_harness_script "$harness"
    doctor_root=$(mktemp -d "${TMPDIR:-/tmp}/devbox-doctor.XXXXXX")
    prepare_agent_payload "$doctor_root" 2>/dev/null || payload_ready=0
  fi
  config=$(compose config --format json) || die "docker compose could not resolve $profile"
  violations=$(printf '%s' "$config" | jq -r --arg worktree "$worktree" --arg gitdir "$gitdir" '
    .services as $services
    | [
        ( $services | to_entries[] | .key as $name | (.value.volumes // [])[]
          | select(.type == "bind")
          | select(.source != $worktree and .source != $gitdir and .source != ($gitdir + "/hooks"))
          | if (.source | endswith("docker.sock"))
            then "I2: service \($name) mounts a Docker socket: \(.source)"
            else "I1: service \($name) mounts a host path: \(.source)" end ),
        ( $services | to_entries[] | .key as $name | (.value.volumes // [])[]
          | select(.type != "bind" and .type != "volume")
          | "I1: service \($name) has mount type \(.type) at \(.target)" ),
        ( $services | to_entries[] | .key as $name | (.value.volumes // [])[]
          | select(.source == ($gitdir + "/hooks") and .read_only != true)
          | "D4: service \($name) mounts the hooks directory read-write" ),
        ( $services | to_entries[] | select(.value.privileged == true)
          | "I3: service \(.key) is privileged" ),
        ( $services | to_entries[] | select((.value.cap_add // []) | length > 0)
          | "I3: service \(.key) adds capabilities: \(.value.cap_add | join(","))" ),
        ( $services | to_entries[] | select((.value.devices // []) | length > 0)
          | "I3: service \(.key) maps devices" ),
        ( $services | to_entries[] | select(.value.network_mode == "host")
          | "I3: service \(.key) uses the host network" ),
        ( $services | to_entries[] | select(.value.pid == "host")
          | "I3: service \(.key) shares the host PID namespace" ),
        ( $services | to_entries[] | select(.value.ipc == "host")
          | "I3: service \(.key) shares the host IPC namespace" ),
        ( (.volumes // {}) | to_entries[] | select(.value.driver_opts.device != null)
          | "I1: volume \(.key) is a host path: \(.value.driver_opts.device)" )
      ] | .[]')
  if [ -n "$violations" ]; then
    printf '%s\n' "$violations" | sed 's/^/devbox doctor: /' >&2
    die "doctor failed — $profile violates I1–I4"
  fi
  echo "devbox doctor: ok — profile $profile, harness $harness, worktree $worktree, gitdir $gitdir"
  if [ "$harness" != none ]; then
    if [ "$payload_ready" = 1 ]; then
      printf '%s\n' "$agent_sources" | sed 's/^/devbox doctor: source /'
      echo "devbox doctor: agent stamp $agent_stamp"
    else
      echo "devbox doctor: agent sources unavailable — up would refuse ($pi_ext_repo, $skillset_repo)"
    fi
    find "$doctor_root" -depth -delete
  fi
}

# Canonical config may not come from the mounted workspace (I6, criterion 9).
for f in "$profile_file" "$compose_file"; do
  case "$f" in "$worktree"/*|"$gitdir"/*) die "refusing canonical config inside the worktree: $f" ;; esac
done

gitdir_ro=false
# `none` is a real label: an image built by hand (Dockerfile default `unstamped`)
# never equals it, and a `none` box keeps being reused.
agent_stamp=none
pi_ext_source=""
skillset_source=""
piext_src=""
skillset_src=""
case "${DEVBOX_BROWSER:-headless}" in
  headless|"") browser_mode=headless ;;
  full) browser_mode=full ;;
  *) die "DEVBOX_BROWSER must be headless or full, not: ${DEVBOX_BROWSER}" ;;
esac
case "$verb" in
  up|shell|doctor) policy=$(policy_read "$worktree") ;;
  down) policy=commits-allowed ;;
  *) usage 1 ;;
esac
[ "$policy" = review-only ] && gitdir_ro=true

case "$verb" in
  up)
    refuse_unknown_extensions
    prepare_gitdir
    # Report, not exit: doctor calls this too, and a missing checkout is not an
    # I1–I4 violation — it only makes the build impossible (0004 D2).
    harness=$(profile_harness)
    require_harness_script "$harness"
    if [ "$harness" != none ]; then
      prepare_agent_payload || die "agent payload unavailable — up refused"
    fi
    image="devbox/dev-$profile:local"
    current=$(docker image inspect "$image" --format '{{ index .Config.Labels "devbox.agent.stamp" }}' 2>/dev/null || true)
    if [ "$rebuild" = 1 ] || ! docker image inspect "$image" >/dev/null 2>&1 || [ "$current" != "$agent_stamp" ]; then
      echo "devbox: building — agent stamp ${agent_stamp:-none}"
      compose up -d --build devbox
    else
      compose up -d devbox
      echo "devbox: image reused — agent stamp ${agent_stamp:-none}"
    fi
    if [ "$gitdir_ro" = true ]; then
      echo "devbox: review-only — git commit is blocked inside; the host commits (D2)"
    fi
    ;;
  shell)  compose exec devbox /bin/zsh -l ;;
  down)
    if [ "$purge" = 1 ]; then
      compose down -v --remove-orphans
    else
      compose down --remove-orphans
      # D10: slr's state never survives the box. Resolve it through compose's own
      # labels rather than by inspecting a container, so a stopped, rebooted or
      # already-deleted container cannot orphan it. Service data (postgres) carries a
      # different logical name and is left to `--purge`.
      for v in $(docker volume ls -q \
                   --filter label=com.docker.compose.project="$project_name" \
                   --filter label=com.docker.compose.volume=devbox-slr); do
        docker volume rm "$v" >/dev/null && echo "devbox: removed slr volume $v (D10)"
      done
    fi
    ;;
  doctor) doctor ;;
  *)      usage 1 ;;
esac
